# Public canonical URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact delivery. Leave unset locally to receive an honest unavailable response.
RESEND_API_KEY=
CONTACT_TO_EMAIL=[Email Address]
CONTACT_FROM_EMAIL=Living Canvas <onboarding@resend.dev>

# Production deployments should replace the built-in single-instance limiter
# with a shared rate-limit provider at the marked integration point.
